   "requirements*.txt",
   "packages.txt",
   "runtime.txt",
   "pyproject.toml",
   "README*",
   "CLAUDE.md",
   "LICENSE*",
   "*.md",
   "*.bat",
   "*.ps1",
   "*.sh",
   "*.log",
   "tests",
   "test_*.py",
   "*_test.py",
   "deploy",
   "scripts",
   "*.lock",
   "*.db-journal",
   "*.bak",
   "*.orig",
   "*.tmp",
   "snowflake",
   ".devcontainer"
  ]
 },
