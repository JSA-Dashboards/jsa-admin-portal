{
 "_comment": "Source of truth for every bundled dashboard. apps/<name>/ is a generated mirror of `repo` (optionally a `subdir` of it): edit the standalone repo, never the copy, then run `python sync/sync_apps.py apply <name>`. Apps with sync=false are skipped; `why` says why.",
 "defaults": {
  "branch": "master",
  "entry": "app.py",
  "exclude": [
   ".git",
   ".github",
   ".gitignore",
   ".gitattributes",
   ".claude",
   ".vscode",
   ".idea",
   ".venv",
   "venv",
   "__pycache__",
   "*.pyc",
   ".streamlit",
   ".env",
   ".env.*",
   "requirements*.txt",
   "packages.txt",
   "runtime.txt",
   "pyproject.toml",
   "README*",
   "CLAUDE.md",
   "LICENSE*",
   "*.md",
   "*.bat",
   "*.ps1",
   "*.sh",
   "*.log",
   "tests",
   "test_*.py",
   "*_test.py",
   "deploy",
   "scripts",
   "*.lock",
   "*.db-journal",
   "*.bak",
   "*.orig",
   "*.tmp",
   "snowflake",
   ".devcontainer"
  ]
 },
 "apps": {
  "beef_cutout": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/beef_cutout"
  },
  "beef_weight": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/beef_weight"
  },
  "cash_trade": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/cash_trade"
  },
  "cattle_on_feed": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/cattle_on_feed"
  },
  "cme_feeder_cattle": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/cme_feeder_cattle"
  },
  "cost_of_carry": {
   "repo": "JSA-Dashboards/cost-of-carry-calculator",
   "branch": "main",
   "prefix_modules": "coc_",
   "exclude": [
    "ams_crush.py",
    "canola_cash.py"
   ]
  },
  "crop_conditions": {
   "repo": "JSA-Dashboards/crop-conditions-dashboard",
   "private": true,
   "pin_env": {
    "FIELD_CHECK": "1"
   }
  },
  "domestic_production": {
   "repo": "JSA-Dashboards/domestic-production-dashboard"
  },
  "eia_energy": {
   "repo": "JSA-Dashboards/eia-energy-dashboard"
  },
  "grain_seasonal": {
   "repo": "JSA-Dashboards/grain-seasonal-dashboard"
  },
  "livestock_inventory": {
   "repo": "JSA-Dashboards/livestock-portal",
   "subdir": "apps/livestock_inventory"
  },
  "rail_fob": {
   "repo": "JSA-Dashboards/rail-fob-portal"
  },
  "rail_shipments": {
   "repo": "JSA-Dashboards/usda-rail-dashboard"
  },
  "rma_map": {
   "repo": "JSA-Dashboards/rma-production-map"
  },
  "vessel_lineup": {
   "repo": "JSA-Dashboards/jsa-vessel-lineup-dashboard",
   "prefix_modules": "vl_",
   "pin_env": {
    "VESSEL_THEME": "light"
   },
   "exclude": [
    "*.db",
    "*.xlsx",
    "southport_poller.py",
    "setup_poller_auth.py",
    "fetch_southport_email.py",
    "convert_southport.py",
    "update_data.*"
   ]
  },
  "teams_broadcast": {
   "repo": "JSA-Dashboards/teams-broadcast",
   "branch": "main",
   "exclude": [
    "whatsapp-service"
   ]
  },
  "cftc_cot": {
   "repo": "JSA-Dashboards/cftc-cot-dashboard",
   "branch": "main",
   "private": true,
   "exclude": [
    "*.sql"
   ]
  },
  "basis_tracker": {
   "repo": "JSA-Dashboards/basis-tracker",
   "prefix_modules": "bt_",
   "preauth": true,
   "pin_env": {
    "SNOWFLAKE_DATABASE": "JSA",
    "SNOWFLAKE_SCHEMA": "BASIS_TRACKER"
   }
  },
  "river_fob": {
   "repo": "JSA-Dashboards/river-fob-portal",
   "prefix_modules": "rf_",
   "preauth": true,
   "pin_env": {
    "SNOWFLAKE_DATABASE": "RIVER_FOB",
    "SNOWFLAKE_SCHEMA": "PUBLIC"
   }
  },
  "major_exporters": {
   "repo": "JSA-Dashboards/global-exports-dashboard",
   "branch": "main",
   "exclude": [
    "etl.py"
   ]
  },
  "yield_portal": {
   "repo": "JSA-Dashboards/yield-portal",
   "prefix_modules": "yp_",
   "wrapper": "sync/templates/yield_portal.py",
   "exclude": [
    "streamlit_app.py",
    "snowflake_admin",
    "logs"
   ]
  },
  "risk_analyzer": {
   "repo": "JSA-Dashboards/jsa-risk-analyzer",
   "wrapper": "sync/templates/risk_analyzer.py",
   "exclude": [
    "secrets.toml.example"
   ]
  },
  "cso_risk_analyzer": {
   "repo": "JSA-Dashboards/cso-risk-analyzer",
   "branch": "main",
   "preauth": true
  }
 },
 "root_files": [
  {
   "repo": "JSA-Dashboards/livestock-portal",
   "path": "wasde.py"
  }
 ]
}